  "dishes": [
    { "id": "osr-hippogriff-steak",    "name": "Hippogriff flank steak",         "section": "main",      "biomes": ["heartland","highland"],  "seasons": ["autumn","winter"],            "tier_min": 3, "cost": 5, "tags": ["refined","noble"],            "flavor": "Seared rare over hawthorn coals. The stable swears its own beasts are all accounted for.", "contains": "meat" },
    { "id": "osr-cockatrice-drumsticks","name": "Cockatrice drumsticks",         "section": "main",      "biomes": ["heartland"],             "seasons": ["all-seasons"], "tier_min": 1, "tier_max": 3, "cost": 2, "tags": ["common"],                     "flavor": "Tastes of chicken. The cook keeps the head in a sack, well away from the soup.", "contains": "meat" },
    { "id": "osr-slime-soup",          "name": "Slime soup",                     "section": "appetizer", "biomes": ["heartland","highland"],  "seasons": ["all-seasons"], "tier_min": 1, "tier_max": 2, "cost": 1, "tags": ["peasant","peculiar"],         "flavor": "Strained gray ooze, green and patient. It stops moving once it cools." },
